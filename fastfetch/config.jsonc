//thanks whoever made this config, it's amazing
//                      -- gordone fryman

 
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.local/share/fastfetch/ascii/cat.txt",
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " •  "
    },
    "modules": [
	"break",
	"break",
		"break",

	{
            "type": "title",
            "color": {
                "user": "32",  // = color2
                "at": "37",
                "host": "32"
            }
        },
        "break",
        {
            "type": "os",
            "key": "distribution   ",
            "keyColor": "33",
        },
        {
            "type": "kernel",
            "key": "linux kernel   ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "key": "packages       ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            "key": "unix shell     ",
            "keyColor": "33", 
        },
        {
            "type": "terminal",
            "key": "terminal       ",
            "keyColor": "33", 
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            "key": "window manager ",
            "keyColor": "33", 
        },
        {
              "type": "uptime",
              "key": "up             ",
              "keyColor": "33"
            },
        {
              "type": "memory",
              "key": "ram            ",
              "keyColor": "33",
              "format": "{used} / {total}"
            },
        {
              "type": "disk",
              "key": "disk           ",
              "keyColor": "33",
              "folders": [
                "/"
              ],
              "format": "{size-used} / {size-total}"
            },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        },
        "break",
        "break",
        	"break",
        
    ]
}
